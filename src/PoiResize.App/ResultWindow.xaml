<Window x:Class="PoiResize.App.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="処理結果" Width="620" Height="420" MinWidth="400" MinHeight="250"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <DockPanel Margin="12">
        <TextBlock x:Name="Summary" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OpenButton" Content="📂 出力フォルダを開く" Click="Open_Click" Padding="12,4" Margin="4" />
            <Button Content="閉じる" Click="Close_Click" IsCancel="True" IsDefault="True" Padding="16,4" Margin="4" />
        </StackPanel>
        <TextBlock x:Name="FailHeader" DockPanel.Dock="Top" Text="失敗したファイルと理由：" Margin="0,0,0,4" />
        <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas, Meiryo UI"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
